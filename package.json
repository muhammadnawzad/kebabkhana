{
	"dependencies": {
		"autoprefixer": "^10.4.20",
		"flowbite": "^2.5.1",
		"postcss": "^8.4.47"
	},
	"scripts": {
		"build:css": "tailwindcss -i ./src/assets/css/app.css -o src/assets/built/app.css",
		"build:js": "esbuild ./src/assets/javascript/app.js --bundle --minify --outfile=src/assets/built/app.js",
		"build": "pnpm run build:css && pnpm run build:js",
		"watch:css": "tailwindcss -i ./src/assets/css/app.css -o src/assets/built/app.css --watch",
		"dev": "pnpm run build:js && pnpm run watch:css"
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.1.8",
		"daisyui": "5.0.43",
		"esbuild": "0.24.0",
		"tailwindcss": "4.1.8"
	}
}
